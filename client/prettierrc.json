{
  "trailingComma": "none",
  "tabWidth": 3,
  "useTabs": true,
  "semi": false,
  "singleQuote": true,

  "plugins": ["@ianvs/prettier-plugin-sort-imports"],

  "importOrder": [
    "<THIRD_PARTY_MODULES>",

    "^@/app/(.*)$",
    "^@/pages/(.*)$",
    "^@/widgets/(.*)$",
    "^@/features/(.*)$",
    "^@/shared/(.*)$",

    "^@/.*$",

    "^../(.*)$",
    "^./(.*)$",

    "\\.(css|scss)$"
  ],

  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
